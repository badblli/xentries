{
  "name": "@xdev/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prisma:generate && tsx watch src/index.ts",
    "start": "pnpm prisma:generate && tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "echo worker lint ok",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo worker format ok",
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@xdev/shared": "workspace:*",
    "bullmq": "^5.41.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
